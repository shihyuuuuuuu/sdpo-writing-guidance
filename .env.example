# Model
MODEL=Qwen/Qwen3.5-9B
JUDGE_MODEL=Qwen/Qwen3.5-9B # local checkpoint or gpt-4.1-mini
JUDGE_API_PROVIDER=local    # local / openai

# Training
LR=2e-6
MAX_DECAY_STEPS=32          # LR schedule horizon; independent of TRAIN_N
SCHEDULER_TYPE=cosine       # cosine / linear
WARMUP_STEPS=5              # 0 = turn off warmup
MIN_LR_RATIO=0.1            # 1 = turn off lr decay，must be between 0 and 1
LOSS_MODE=simple_signal     # "simple_signal" | "full_distillation" | "opsd_forward_kl_clip"
MAX_GRAD_NORM=0.3
TRAIN_N=512
EVAL_N=100
EVAL_EVERY=3                # 每幾 batch 評估一次
BATCH_SIZE=16
SEED=4772

# Generation
# Assistant
MAX_INPUT_TOKENS=2048       # 參考：630/634，包含 o 最高 754
MAX_NEW_TOKENS=1024         # 參考：(zh)716/659, (en)225/230
TEMPERATURE=0.7
# Judge

# Data
DATA_DIR="./data/金庸/context_4"
# DATA_DIR="./data/Edgar Allan Poe/context_4"
LANGUAGE=zh                 # en / zh

# GPU
MODEL_GPU=0
JUDGE_GPU=1

# VLLM
MODEL_VLLM=false
VLLM_GPU=1
VLLM_GPU_MEM=0.5

# Checkpoints
SAVE_CHECKPOINTS=false
