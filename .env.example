# Model
MODEL=Qwen/Qwen3.5-9B
USER_MODEL=Qwen/Qwen3-8B    # Qwen/Qwen3-8B / gpt-4.1-mini
USER_API_PROVIDER=local     # local / openai

# Training
LR=2e-6
LOSS_MODE=simple_signal
TRAIN_N=320
EVAL_N=100
EVAL_EVERY=3                # 每幾 batch 評估一次
BATCH_SIZE=16
SEED=65

# Generation
# Assistant
MAX_INPUT_TOKENS=1024       # 參考：630/634，包含 o 最高 754
MAX_NEW_TOKENS=384          # 參考：(zh)716/659, (en)225/230
TEMPERATURE=0.7
# User (Author)
USER_MAX_INPUT_TOKENS=2400  # 參考：(zh)1909/1833, (en)1286
USER_MAX_NEW_TOKENS=256     # 參考：(zh)102/83, (en)80
# USER_TEMPERATURE=0.7      # 寫死在 class 裡
# Judge

# Data
DATA_DIR="./data/張愛玲/context_2"
# DATA_DIR="./data/Edgar Allan Poe/context_2"
LANGUAGE=zh                 # en / zh

# GPU
MODEL_GPU=0
USER_GPU=1

# VLLM
MODEL_VLLM=false
USER_VLLM=false
VLLM_GPU=1
VLLM_GPU_MEM=0.5

# Checkpoints
SAVE_CHECKPOINTS=false

STYLE_MODE=false
